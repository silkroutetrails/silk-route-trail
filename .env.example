# ---- Required for the live site ----
# MongoDB connection string (MongoDB Atlas: Connect > Drivers). Leave empty to run in PREVIEW mode with sample content.
DATABASE_URI=
# Any long random string (at least 32 characters). Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
# Public address of the site, no trailing slash, e.g. https://www.silkroutetrails.pk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Image storage (needed on Vercel; local disk is wiped between deployments) ----
# Vercel dashboard > Storage > Blob > create store; the token is added automatically when you connect it.
BLOB_READ_WRITE_TOKEN=

# ---- Email (enquiry notifications and visitor acknowledgements) ----
# Any SMTP provider (Zoho, Gmail app password, Brevo, Resend SMTP, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown on emails, must be allowed by your SMTP provider
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Silk Route Trails
# Where new enquiries are sent (can also be set in Admin > Site Settings)
NOTIFY_EMAIL=
